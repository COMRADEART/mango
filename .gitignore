# --- Session runtime artifacts (regenerated, never content) ---
.claude/scheduled_tasks.lock

# --- Data: raw/processed corpora are reproducible from source manifests; do
#     not commit bulk datasets ---
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# --- Model artifacts: multi-GB ---
training/checkpoints/*
training/adapters/*/adapter_model.safetensors
training/logs/*.out
rag/index/*
rag/embeddings/*
rag/corpus/*.jsonl

# --- Evaluation predictions can be large; keep metrics/manifests ---
evaluations/*/predictions.jsonl

# T23 one-shot blind material is private; preconstruction specifications stay tracked.
rag/gk_holdout_t23/
evaluations/t23/suites/
evaluations/t23/construction_run_ledger.json
evaluations/t23/construction_audits.json
evaluations/t23/holdout_manifest.json
evaluations/t23/HOLDOUT_FROZEN
evaluations/t23/evaluation_run_ledger.json
evaluations/t23/router_decisions.jsonl
evaluations/t23/selected_capability_execution.jsonl
evaluations/t23/candidate_outputs.jsonl
evaluations/t23/router_evaluator.jsonl
evaluations/t23/capability_evaluator.jsonl
evaluations/t23/raw_results.jsonl
evaluations/t23/router_metric_evidence.json
evaluations/t23/router_floor_evidence.json
evaluations/t23/t22_disposable_scorer_rehearsal.json
evaluations/t23/protected_t22_metric_evidence.json
evaluations/t23/protected_t22_floor_evidence.json
evaluations/t23/holdout_results.json
evaluations/t23/evaluation_provenance.json

# --- T18 persistent memory: local runtime DBs never in git ---
runtime/memory/*
!runtime/memory/.gitkeep
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db-wal
*.db-shm

# --- Secrets: NEVER commit credentials or tokens ---
.env
*.env
kaggle.json
hf_token.txt
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
tests/.pytest_tmp/
build/
dist/
.venv/
venv/
.idea/
.vscode/
*.log
